# KCM Docker Ignore
# Exclude everything not needed for building the Docker image

# Version control
.git/
.gitignore
.github/
.gitattributes

# Documentation
docs/
*.md
LICENSE
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md

# Development / IDE
.vscode/
.idea/
*.swp
*.swo

# Build artifacts (will be rebuilt in container)
target/
**/target/

# Benchmark results
benchmark-results/

# AI governance
skills/
.agents/
.kilo/

# KCM snapshots
.kcm_snapshots/

# SDKs (not needed for server build)
sdk/

# Examples
examples/

# Scripts (except kcm-cli which is needed for workspace resolution)
scripts/validate-ssot.sh
scripts/bench-regression.py
scripts/README.md

# Deployment configs (not needed in container)
deployment/grafana/
deployment/prometheus/
deployment/terraform/
deployment/helm/

# Config files
kilo.json
.dockerignore

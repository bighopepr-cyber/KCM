{
  "name": "@kcm/js",
  "version": "0.1.0",
  "description": "KCM Knowledge Columnar Model - JavaScript/TypeScript SDK (reference implementation)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {

      "operations": [
        {"action": "insert", "fact": {"subject": 1, "predicate": 1, "object": 1, "confidence": 0.5, "evidence": 1, "context": 1, "priority": 0, "owner": 1}},
        {"action": "update", "row_id": 1, "fact": {"confidence": 0.99}},

      "category": "unit",
      "operations": [
        {"action": "insert", "fact": {"subject": 1, "predicate": 2, "object": 3, "confidence": 0.95, "evidence": 1, "context": 1, "priority": 0, "owner": 1}},
        {"action": "verify_count", "expected": 1}
      ],

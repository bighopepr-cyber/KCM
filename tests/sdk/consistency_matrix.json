      "operations": [
        {"action": "insert", "fact": {"subject": 5, "predicate": 5, "object": 5, "confidence": 1.0, "evidence": 1, "context": 1, "priority": 0, "owner": 1}},
        {"action": "get_count", "expected": 1},
        {"action": "delete", "row_id": 1},
        {"action": "get_count", "expected": 0}
      ],
      "required_sdks": ["rust", "python", "javascript", "typescript", "go", "java", "dotnet", "c", "cpp"],
      "results": {}
    },
    {

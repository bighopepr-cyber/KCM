      "category": "unit",
      "operations": [
        {"action": "insert", "fact": {"subject": 10, "predicate": 20, "object": 30, "confidence": 0.8, "evidence": 2, "context": 2, "priority": 1, "owner": 2}},
        {"action": "query_all", "expected_count": 1, "validate_fields": true}
      ],
      "required_sdks": ["rust", "python", "javascript", "typescript", "go", "java", "dotnet", "c", "cpp"],
      "results": {}
